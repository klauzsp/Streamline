# Optional; without these, deterministic investigation remains available.
# vertex: ADC via GOOGLE_APPLICATION_CREDENTIALS + project/location, or Express key
AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Override if your Python 3 is elsewhere. macOS system Python is used by default.
# PYTHON_PATH=/usr/bin/python3
